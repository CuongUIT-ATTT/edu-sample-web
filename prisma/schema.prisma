datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum EventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

enum ParticipantRole {
  ORGANIZER
  ATTENDEE
}

enum ParticipantResponse {
  PENDING
  ACCEPTED
  DECLINED
}

enum ReminderMethod {
  POPUP
  EMAIL
  NOTIFICATION
}

enum ExceptionStatus {
  MODIFIED
  CANCELLED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  adminProfile   AdminProfile?
  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  parentProfile  ParentProfile?

  calendars           Calendar[]
  ownedEvents         Event[]
  eventParticipations EventParticipant[]
}

model AdminProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects  Subject[] // Many-to-many relationship with subjects they teach
  classes   Class[] // Classes they are the form teacher of
  schedules Schedule[] // Schedules they teach
  scheduleSeries ScheduleSeries[] // Schedules (series) they teach
  grades    Grade[] // Grades they recorded
  quizzes   Quiz[]
  createdDocuments Document[] // Tài liệu GV tạo
}

model StudentProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  classes Class[]

  parentId String?
  parent   ParentProfile? @relation(fields: [parentId], references: [id], onDelete: SetNull)

  attendances         Attendance[]
  grades              Grade[]
  enrollments         Enrollment[]
  quizSubmissions     QuizSubmission[]
  homeworkSubmissions HomeworkSubmission[]
  tuitions            Tuition[]
  tuitionPayments     TuitionPayment[]
  credits             StudentCredit[]
}

model ParentProfile {
  id       String           @id @default(uuid())
  userId   String           @unique
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  students StudentProfile[] // A parent can have multiple students
}

model Class {
  id         String @id @default(uuid())
  name       String @unique // e.g., "10A1", "12B3"
  gradeLevel Int // e.g., 10, 11, 12

  formTeacherId String?
  formTeacher   TeacherProfile? @relation(fields: [formTeacherId], references: [id], onDelete: SetNull)

  students           StudentProfile[]
  schedules          Schedule[]
  scheduleSeries     ScheduleSeries[]
  quizzes            Quiz[]
  documentVisibility DocumentClassVisibility[]
  tuitions           Tuition[]
  credits            StudentCredit[]
}

model Subject {
  id        String           @id @default(uuid())
  name      String           @unique // e.g., "Mathematics", "Physics"
  code      String           @unique // e.g., "MATH101"
  teachers  TeacherProfile[]
  schedules Schedule[]
  scheduleSeries ScheduleSeries[]
  grades    Grade[]
  quizzes   Quiz[]
}

model Schedule {
  id        String         @id @default(uuid())
  classId   String
  class     Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  dayOfWeek Int // 1 = Monday, ..., 7 = Sunday
  startTime String // "08:00"
  endTime   String // "09:30"
  room      String? // e.g., "Room 302"

  date              DateTime? // Specific calendar date
  recurrenceGroupId String? // ID to group weekly occurrences together
  materials         String? // URL or JSON of preview documents
  homework          String? // URL or JSON of homework files
  homeworkDueDate   DateTime? // Deadline for homework submission
  homeworkQuizId    String?
  homeworkQuiz      Quiz?                @relation(fields: [homeworkQuizId], references: [id], onDelete: SetNull)
}

// ─── Lịch học (Master + Exception — Google Calendar model) ──────────
// ScheduleSeries: 1 chuỗi lặp (master). Instance hiển thị trên calendar được tính runtime.
// ScheduleException: ngoại lệ (override/hủy) cho 1 buổi cụ thể trong series.

model ScheduleSeries {
  id        String         @id @default(uuid())
  classId   String
  class     Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  dayOfWeek Int // 1 = Monday, ..., 7 = Sunday
  startTime String // "08:00"
  endTime   String // "09:30"
  room      String? // e.g., "Room 302"

  startDate DateTime // Bắt buộc — ngày đầu tiên trong chuỗi
  endDate   DateTime? // nullable = lặp vô hạn

  materials       String?
  homework        String?
  homeworkDueDate DateTime?
  homeworkQuizId  String?
  homeworkQuiz    Quiz?                @relation(fields: [homeworkQuizId], references: [id], onDelete: SetNull)

  exceptions  ScheduleException[]
  submissions HomeworkSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([classId, dayOfWeek])
  @@index([teacherId, dayOfWeek])
  @@index([room, dayOfWeek])
  @@index([startDate])
}

model ScheduleException {
  id           String         @id @default(uuid())
  seriesId     String
  series       ScheduleSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  originalDate DateTime // Ngày gốc của occurrence bị override (UTC midnight)

  status ExceptionStatus // MODIFIED = sửa, CANCELLED = hủy

  // Override fields (chỉ dùng khi MODIFIED; null = giữ nguyên từ series)
  classId   String?
  subjectId String?
  teacherId String?
  room      String?
  startTime String?
  endTime   String?

  materials       String?
  homework        String?
  homeworkDueDate DateTime?
  homeworkQuizId  String?

  // Dời ngày: buổi gốc tại originalDate chuyển sang rescheduledDate (1 buổi đặc biệt ngoài lưới dayOfWeek).
  // null = giữ nguyên ngày.
  rescheduledDate DateTime?

  @@unique([seriesId, originalDate])
  @@index([seriesId])
  @@index([originalDate])
}

model HomeworkSubmission {
  id           String         @id @default(uuid())
  seriesId     String
  series       ScheduleSeries @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  instanceDate DateTime       // Ngày cụ thể của buổi học trong chuỗi (UTC midnight)
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileUrl      String // The submitted homework document link
  fileName     String? // Human readable filename
  submittedAt  DateTime       @default(now())
  grade        Float? // Optional grade given by teacher
  feedback     String? // Teacher feedback
  gradeRelation Grade?

  @@unique([seriesId, instanceDate, studentId])
  @@index([seriesId, instanceDate])
}

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime // Date of attendance
  status    AttendanceStatus
  remarks   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([studentId, date])
}

model Grade {
  id                   String              @id @default(uuid())
  studentId            String
  student              StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId            String
  subject              Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId            String
  teacher              TeacherProfile      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  homeworkSubmissionId String?             @unique
  homeworkSubmission   HomeworkSubmission? @relation(fields: [homeworkSubmissionId], references: [id], onDelete: Cascade)

  type      String // e.g., "QUIZ", "MIDTERM", "FINAL"
  score     Float // numeric score
  weight    Float // percentage weight (e.g. 0.2 for midterm)
  remarks   String?
  date      DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id          String       @id @default(uuid())
  title       String
  description String?
  thumbnail   String?
  level       Int // e.g. 10, 11, 12
  published   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  modules     Module[]
  enrollments Enrollment[]
}

model Module {
  id       String   @id @default(uuid())
  title    String
  order    Int
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]
}

model Lesson {
  id          String  @id @default(uuid())
  title       String
  videoUrl    String?
  documentUrl String?
  content     String?
  order       Int
  moduleId    String
  module      Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id         String         @id @default(uuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime       @default(now())

  @@unique([studentId, courseId])
}

model Quiz {
  id               String  @id @default(uuid())
  title            String
  description      String?
  duration         Int // in minutes
  passingScore     Float
  deadline         DateTime? // null = không đóng đề; sau deadline vẫn làm được nhưng đánh dấu nộp muộn
  isPublic         Boolean @default(false)
  answerVisibility String  @default("IMMEDIATELY") // IMMEDIATELY, WHEN_ENDED, NEVER, AFTER_ALL_SUBMITTED

  subjectId String
  subject   Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId String?
  teacher   TeacherProfile? @relation(fields: [teacherId], references: [id], onDelete: SetNull)

  classId String?
  class   Class?  @relation(fields: [classId], references: [id], onDelete: SetNull)

  questions   Question[]
  submissions QuizSubmission[]
  schedules   Schedule[]
  scheduleSeries ScheduleSeries[]
}

model Question {
  id            String  @id @default(uuid())
  text          String
  type          String // e.g. "MULTIPLE_CHOICE"
  options       Json // Array of choices, e.g. ["A", "B", "C", "D"]
  correctAnswer String // Index or text of correct answer
  score         Float   @default(1.0)
  explanation   String?
  imageUrl      String?

  quizId String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizSubmission {
  id        String          @id @default(uuid())
  studentId String?
  student   StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizId    String
  quiz      Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)

  score       Float
  answers     Json // Map of question ID to student's answer
  guestName   String?
  submittedAt DateTime @default(now())
  isLate      Boolean  @default(false)
}

model Room {
  id        String   @id @default(uuid())
  name      String   @unique
  capacity  Int?
  createdAt DateTime @default(now())
}

model Document {
  id          String   @id @default(uuid())
  title       String
  description String?
  fileUrl     String
  fileName    String
  fileType    String // 'pdf' or 'docx'
  fileSize    String?
  category    String   @default("Chung")
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Người tạo document (TeacherProfile.id). Admin = null. Dùng để giới hạn GV chỉ sửa/xóa doc của mình.
  createdById String?
  createdBy   TeacherProfile? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  classVisibility DocumentClassVisibility[]
}

model DocumentClassVisibility {
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  classId    String
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([documentId, classId])
}

// ─── Calendar / Events ─────────────────────────────────────────────

model Calendar {
  id              String   @id @default(uuid())
  name            String
  color           String   @default("#4285F4")
  isVisible       Boolean  @default(true)
  timezoneDefault String   @default("Asia/Ho_Chi_Minh")
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  events          Event[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Event {
  id             String             @id @default(uuid())
  title          String
  description    String?
  location       String?
  startTime      DateTime // UTC
  endTime        DateTime // UTC
  isAllDay       Boolean            @default(false)
  timezone       String             @default("Asia/Ho_Chi_Minh")
  color          String             @default("#4285F4")
  recurrenceRule String? // RRULE string (RFC 5545), e.g. "FREQ=WEEKLY;BYDAY=MO,WE,FR"
  recurrenceId   String? // set on exception instances only
  status         EventStatus        @default(CONFIRMED)
  calendarId     String
  calendar       Calendar           @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  participants   EventParticipant[]
  reminders      Reminder[]
  exceptions     EventException[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([calendarId, startTime])
  @@index([ownerId])
}

model EventException {
  id            String       @id @default(uuid())
  eventId       String
  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  originalStart DateTime // UTC — identifies which instance was modified
  recurrenceId  String // generated ID for this recurrence instance
  title         String?
  description   String?
  location      String?
  startTime     DateTime? // UTC — overridden start
  endTime       DateTime? // UTC — overridden end
  isAllDay      Boolean?
  status        EventStatus?
}

model EventParticipant {
  id             String              @id @default(uuid())
  eventId        String
  event          Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  responseStatus ParticipantResponse @default(PENDING)
  role           ParticipantRole     @default(ATTENDEE)
}

model Reminder {
  id            String         @id @default(uuid())
  eventId       String
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  method        ReminderMethod @default(POPUP)
  minutesBefore Int
}

// ─── Tuition / Học phí ─────────────────────────────────────────────

model StudentCredit {
  id        String         @id @default(uuid())
  studentId String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId   String
  class     Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  credit    Float          @default(0)
  updatedAt DateTime       @updatedAt

  @@unique([studentId, classId])
}

model TuitionFeeSetting {
  id             String   @id @default(uuid())
  pricePerPeriod Float    @default(15000)
  updatedAt      DateTime @updatedAt
  updatedBy      String
}

model Tuition {
  id        String  @id @default(uuid())
  studentId String
  classId   String
  month     Int
  year      Int
  periods   Int
  amount    Float
  paid      Float   @default(0)
  status    String  @default("PENDING")
  note      String?

  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  payments  TuitionPayment[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([studentId, classId, month, year])
}

model TuitionPayment {
  id         String   @id @default(uuid())
  tuitionId  String
  studentId  String
  amount     Float
  paidAt     DateTime
  method     String   @default("CASH")
  note       String?
  recordedBy String

  tuition Tuition        @relation(fields: [tuitionId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
