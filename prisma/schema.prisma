datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
  PARENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum EventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

enum ParticipantRole {
  ORGANIZER
  ATTENDEE
}

enum ParticipantResponse {
  PENDING
  ACCEPTED
  DECLINED
}

enum ReminderMethod {
  POPUP
  EMAIL
  NOTIFICATION
}

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  name         String
  role         Role
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  adminProfile   AdminProfile?
  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  parentProfile  ParentProfile?

  calendars          Calendar[]
  ownedEvents        Event[]
  eventParticipations EventParticipant[]
}

model AdminProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects  Subject[]  // Many-to-many relationship with subjects they teach
  classes   Class[]    // Classes they are the form teacher of
  schedules Schedule[] // Schedules they teach
  grades    Grade[]    // Grades they recorded
  quizzes   Quiz[]
}

model StudentProfile {
  id              String           @id @default(uuid())
  userId          String           @unique
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  classes         Class[]
  
  parentId        String?
  parent          ParentProfile?   @relation(fields: [parentId], references: [id], onDelete: SetNull)
  
  attendances     Attendance[]
  grades          Grade[]
  enrollments     Enrollment[]
  quizSubmissions     QuizSubmission[]
  homeworkSubmissions HomeworkSubmission[]
}

model ParentProfile {
  id       String           @id @default(uuid())
  userId   String           @unique
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  students StudentProfile[] // A parent can have multiple students
}

model Class {
  id               String          @id @default(uuid())
  name             String          @unique // e.g., "10A1", "12B3"
  gradeLevel       Int             // e.g., 10, 11, 12
  
  formTeacherId    String?
  formTeacher      TeacherProfile? @relation(fields: [formTeacherId], references: [id], onDelete: SetNull)
  
  students         StudentProfile[]
  schedules        Schedule[]
  quizzes          Quiz[]
}

model Subject {
  id        String           @id @default(uuid())
  name      String           @unique // e.g., "Mathematics", "Physics"
  code      String           @unique // e.g., "MATH101"
  teachers  TeacherProfile[]
  schedules Schedule[]
  grades    Grade[]
  quizzes   Quiz[]
}

model Schedule {
  id                String               @id @default(uuid())
  classId           String
  class             Class                @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId         String
  subject           Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId         String
  teacher           TeacherProfile       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  
  dayOfWeek         Int                  // 1 = Monday, ..., 7 = Sunday
  startTime         String               // "08:00"
  endTime           String               // "09:30"
  room              String?              // e.g., "Room 302"
  
  date              DateTime?            // Specific calendar date
  recurrenceGroupId String?              // ID to group weekly occurrences together
  materials         String?              // URL or JSON of preview documents
  homework          String?              // URL or JSON of homework files
  homeworkDueDate   DateTime?            // Deadline for homework submission
  homeworkQuizId    String?
  homeworkQuiz      Quiz?                @relation(fields: [homeworkQuizId], references: [id], onDelete: SetNull)
  submissions       HomeworkSubmission[]
}

model HomeworkSubmission {
  id          String         @id @default(uuid())
  scheduleId  String
  schedule    Schedule       @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fileUrl     String         // The submitted homework document link
  fileName    String?        // Human readable filename
  submittedAt DateTime       @default(now())
  grade       Float?         // Optional grade given by teacher
  feedback    String?        // Teacher feedback
  gradeRelation Grade?
  
  @@unique([scheduleId, studentId])
}

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  student   StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  date      DateTime         // Date of attendance
  status    AttendanceStatus
  remarks   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([studentId, date])
}

model Grade {
  id                   String              @id @default(uuid())
  studentId            String
  student              StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subjectId            String
  subject              Subject             @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId            String
  teacher              TeacherProfile      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  homeworkSubmissionId String?             @unique
  homeworkSubmission   HomeworkSubmission? @relation(fields: [homeworkSubmissionId], references: [id], onDelete: Cascade)
  
  type      String         // e.g., "QUIZ", "MIDTERM", "FINAL"
  score     Float          // numeric score
  weight    Float          // percentage weight (e.g. 0.2 for midterm)
  remarks   String?
  date      DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Course {
  id          String           @id @default(uuid())
  title       String
  description String?
  thumbnail   String?
  level       Int              // e.g. 10, 11, 12
  published   Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  modules     Module[]
  enrollments Enrollment[]
}

model Module {
  id       String   @id @default(uuid())
  title    String
  order    Int
  courseId String
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  Lesson[]
}

model Lesson {
  id          String   @id @default(uuid())
  title       String
  videoUrl    String?
  documentUrl String?
  content     String?
  order       Int
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id         String         @id @default(uuid())
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime       @default(now())

  @@unique([studentId, courseId])
}

model Quiz {
  id               String           @id @default(uuid())
  title            String
  description      String?
  duration         Int              // in minutes
  passingScore     Float
  isPublic         Boolean          @default(false)
  answerVisibility String           @default("IMMEDIATELY") // IMMEDIATELY, WHEN_ENDED, NEVER
  
  subjectId    String
  subject      Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacherId    String?
  teacher      TeacherProfile?  @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  
  classId      String?
  class        Class?           @relation(fields: [classId], references: [id], onDelete: SetNull)
  
  questions    Question[]
  submissions  QuizSubmission[]
  schedules    Schedule[]
}

model Question {
  id            String   @id @default(uuid())
  text          String
  type          String   // e.g. "MULTIPLE_CHOICE"
  options       Json     // Array of choices, e.g. ["A", "B", "C", "D"]
  correctAnswer String   // Index or text of correct answer
  score         Float    @default(1.0)
  explanation   String?
  imageUrl      String?
  
  quizId        String
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
}

model QuizSubmission {
  id          String          @id @default(uuid())
  studentId   String?
  student     StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  quizId      String
  quiz        Quiz            @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  score       Float
  answers     Json            // Map of question ID to student's answer
  guestName   String?
  submittedAt DateTime        @default(now())
}

model Room {
  id        String   @id @default(uuid())
  name      String   @unique
  capacity  Int?
  createdAt DateTime @default(now())
}

model Document {
  id          String   @id @default(uuid())
  title       String
  description String?
  fileUrl     String
  fileName    String
  fileType    String   // 'pdf' or 'docx'
  fileSize    String?
  category    String   @default("Chung")
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Calendar / Events ─────────────────────────────────────────────

model Calendar {
  id              String   @id @default(uuid())
  name            String
  color           String   @default("#4285F4")
  isVisible       Boolean  @default(true)
  timezoneDefault String   @default("Asia/Ho_Chi_Minh")
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  events          Event[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Event {
  id             String        @id @default(uuid())
  title          String
  description    String?
  location       String?
  startTime      DateTime      // UTC
  endTime        DateTime      // UTC
  isAllDay       Boolean       @default(false)
  timezone       String        @default("Asia/Ho_Chi_Minh")
  color          String        @default("#4285F4")
  recurrenceRule String?       // RRULE string (RFC 5545), e.g. "FREQ=WEEKLY;BYDAY=MO,WE,FR"
  recurrenceId   String?       // set on exception instances only
  status         EventStatus   @default(CONFIRMED)
  calendarId     String
  calendar       Calendar      @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  participants   EventParticipant[]
  reminders      Reminder[]
  exceptions     EventException[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([calendarId, startTime])
  @@index([ownerId])
}

model EventException {
  id            String      @id @default(uuid())
  eventId       String
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  originalStart DateTime    // UTC — identifies which instance was modified
  recurrenceId  String      // generated ID for this recurrence instance
  title         String?
  description   String?
  location      String?
  startTime     DateTime?   // UTC — overridden start
  endTime       DateTime?   // UTC — overridden end
  isAllDay      Boolean?
  status        EventStatus?
}

model EventParticipant {
  id             String              @id @default(uuid())
  eventId        String
  event          Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  responseStatus ParticipantResponse @default(PENDING)
  role           ParticipantRole     @default(ATTENDEE)
}

model Reminder {
  id            String         @id @default(uuid())
  eventId       String
  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  method        ReminderMethod @default(POPUP)
  minutesBefore Int
}

